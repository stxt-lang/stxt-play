{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],

    "rootDir": "src",

    "strict": true,
    "noEmit": true,

    "module": "ESNext",
    "moduleResolution": "bundler",

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
