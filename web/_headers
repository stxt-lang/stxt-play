# Cache policy of the served directory.
#
# index.html is never cached: it is the entry point and it carries the version of every asset it
# references (?v=<content hash>, stamped by `npm run build`). The assets themselves keep fixed
# names but a URL that changes with their content, so they can be cached for as long as wanted.

/
  Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
